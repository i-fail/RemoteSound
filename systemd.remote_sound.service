[Unit]
Description=Remote Sound Bun App
After=network.target

[Service]
Type=simple
User=cardify
WorkingDirectory=/home/cardify/remote-sound
Environment=NODE_ENV=production
Environment=PORT=3000
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/cardify/.bun/bin/bun /home/cardify/remote-sound/src/server.ts
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=20

# Optional local environment overrides
# EnvironmentFile=/home/cardify/remote-sound/.env

[Install]
WantedBy=multi-user.target
